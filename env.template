# Copy this file to .env and configure with your values

# Google Cloud: BigQuery (one dataset per layer) + Firestore (API keys, catalogue, certifications, counters)
# Credentials come from Application Default Credentials:
#   locally: gcloud auth application-default login
#   on Cloud Run: the service's runtime service account
GCP_PROJECT_ID=odis-stream2-app
BIGQUERY_DATASET_PREFIX=odas
BIGQUERY_LOCATION=europe-west1
FIRESTORE_DATABASE=(default)

# Optional: caps on what the API may spend per query and per UTC day (bytes; defaults 5 GiB, 20 GiB, 5 GiB)
# QUERY_MAX_BYTES_BILLED=5368709120
# QUERY_DAILY_BYTES_BUDGET=21474836480
# EXPORT_DAILY_BYTES_BUDGET=5368709120

# API Configuration - REQUIRED
ADMIN_SECRET=REPLACE_WITH_STRONG_SECRET

# Environment (development, staging, production)
ENVIRONMENT=development

# CORS (comma-separated origins, or * for development only)
CORS_ORIGINS=*
